# Application ports. SERVER_PORT takes precedence over the legacy PORT variable.
SERVER_PORT=3001
CLIENT_PORT=5173

# Local voice transcription defaults.
WHISPER_LANGUAGE=auto
WHISPER_MODEL_PATH=models/ggml-base.bin
FFMPEG_PATH=ffmpeg
AUDIO_TRANSCRIPTION_TIMEOUT_MS=120000

# Optional: override automatic project-local/PATH discovery.
# Relative paths are resolved from the repository root.
# WHISPER_CPP_PATH=.local/whisper.cpp/build/bin/whisper-cli
